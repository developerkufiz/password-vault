# Copy to .env for local dev. On Render, set these as Environment Variables instead.

# --- TiDB Cloud (Connect button -> "Connect With: General" gives you these) ---
TIDB_HOST=gateway01.xxxxxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxxxxx.root
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=passwordvault

# --- Auth ---
# Any long random string. On Render use "Generate" so it is created for you.
JWT_SECRET=change-me-to-a-long-random-string

# Local port (Render sets PORT automatically, leave this for local only)
PORT=3000